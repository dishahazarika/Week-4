//6. Write a program to delete a substring from a text.

#include <stdio.h>
#include <string.h>

int main() {
    char text[200], sub[100];
    char *pos;

    printf("Enter the main text: ");
    gets(text);
    printf("Enter substring to delete: ");
    gets(sub);

    pos = strstr(text, sub);

    if (pos != NULL) {
        int i = pos - text;
        int len = strlen(sub);
        while (text[i + len] != '\0') {
            text[i] = text[i + len];
            i++;
        }
        text[i] = '\0';
        printf("Updated text: %s\n", text);
    } else {
        printf("Substring not found.\n");
    }

    return 0;
}
